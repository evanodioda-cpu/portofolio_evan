        // Switcher between Live Website Preview & File Explorer
        function switchMainView(view) {
            const btnPreview = document.getElementById('btn-preview');
            const btnExplorer = document.getElementById('btn-explorer');
            const viewPreview = document.getElementById('view-preview');
            const viewExplorer = document.getElementById('view-explorer');

            if (view === 'preview') {
                btnPreview.className = "px-3.5 py-1.5 rounded-lg text-sm font-medium bg-blue-600 text-white transition hover:bg-blue-500 flex items-center space-x-2";
                btnExplorer.className = "px-3.5 py-1.5 rounded-lg text-sm font-medium bg-slate-800 text-slate-300 transition hover:bg-slate-700 flex items-center space-x-2";
                viewPreview.classList.remove('hidden');
                viewExplorer.classList.add('hidden');
            } else {
                btnExplorer.className = "px-3.5 py-1.5 rounded-lg text-sm font-medium bg-blue-600 text-white transition hover:bg-blue-500 flex items-center space-x-2";
                btnPreview.className = "px-3.5 py-1.5 rounded-lg text-sm font-medium bg-slate-800 text-slate-300 transition hover:bg-slate-700 flex items-center space-x-2";
                viewExplorer.classList.remove('hidden');
                viewPreview.classList.add('hidden');
                selectCodeFile('index.html');
            }
        }

        // Live Preview Navigation Simulator
        function navigatePreview(pagePath) {
            document.querySelectorAll('.preview-page').forEach(page => {
                page.classList.add('hidden');
            });

            const targetPageId = 'page-' + pagePath;
            const targetElement = document.getElementById(targetPageId);
            if (targetElement) {
                targetElement.classList.remove('hidden');
            }

            document.getElementById('preview-path').innerText = pagePath;
            document.getElementById('relative-path-badge').innerText = './' + pagePath;

            document.querySelectorAll('.nav-tab').forEach(tab => {
                if (tab.getAttribute('data-target') === pagePath) {
                    tab.className = "nav-tab text-white bg-blue-600 px-3 py-1.5 rounded-lg transition";
                } else {
                    tab.className = "nav-tab text-slate-300 hover:text-white hover:bg-slate-800 px-3 py-1.5 rounded-lg transition";
                }
            });
        }

        // Code Explorer File Selection
        function selectCodeFile(filename) {
            document.querySelectorAll('.file-tree-item').forEach(item => {
                item.classList.remove('active');
            });
            const selectedItem = document.getElementById('tree-' + filename);
            if (selectedItem) {
                selectedItem.classList.add('active');
            }

            document.getElementById('active-filename').innerText = filename;
            document.getElementById('code-content-display').innerText = projectFiles[filename] || "// File not found.";
        }

        // Copy Code to Clipboard
        function copyCurrentCode() {
            const codeText = document.getElementById('code-content-display').innerText;
            navigator.clipboard.writeText(codeText).then(() => {
                showToast("Kode berhasil disalin ke clipboard!");
            });
        }

        // Simulated Form Handler
        function handleSimulatedForm(event) {
            event.preventDefault();
            showToast("Pesan berhasil dikirim ke Rafael!");
            event.target.reset();
        }

        // Toast Notification Helper
        function showToast(message) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-msg').innerText = message;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        // Download Project as ZIP using JSZip
        async function downloadProjectZip() {
            if (typeof JSZip === 'undefined') {
                alert("Library JSZip belum termuat sempurna. Periksa koneksi internet Anda.");
                return;
            }

            const zip = new JSZip();
            for (const [path, content] of Object.entries(projectFiles)) {
                zip.file(path, content);
            }

            try {
                const content = await zip.generateAsync({ type: "blob" });
                const url = window.URL.createObjectURL(content);
                const a = document.createElement('a');
                a.href = url;
                a.download = "portofolio-digital-rafael.zip";
                document.body.appendChild(a);
                a.click();
                window.URL.revokeObjectURL(url);
                document.body.removeChild(a);
                showToast("File ZIP portofolio berhasil diunduh!");
            } catch (err) {
                console.error(err);
                alert("Terjadi kesalahan saat membuat file ZIP.");
            }
        }
